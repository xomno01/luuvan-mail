# PastelMail Environment Variables Template
# Copy this file to .dev.vars for local Wrangler development,
# or set secrets directly in Cloudflare Workers using:
# wrangler secret put RESEND_API_KEY

# Resend API Key: Can be a single API key, comma-separated keys for pool rotation,
# or a JSON string mapping specific ecosystem domains to specific keys:
#
# Single Key Example:
# RESEND_API_KEY="re_12345678_xxxxxxxxxxxxxxxxxxxx"
#
# Multi-Domain JSON Map Example:
RESEND_API_KEY='{"luuvan.online":"re_xxxx","aetherix.site":"re_xxxx","chotroi.site":"re_xxxx","aadidass.tokyo":"re_xxxx"}'

# Enterprise JWT / HMAC Secret for Edge Token Authentication:
JWT_SECRET="pastelmail_cloudflare_edge_secret_key_2026_super_secure"
